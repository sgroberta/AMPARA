# Copie para .env se for usar com um gerenciador de variáveis; o servidor lê process.env.
PORT=3000
# Token das rotas /api/admin (sem ele, essas rotas ficam desativadas). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Pasta do banco e dos arquivos enviados (padrão: backend/data)
DATA_DIR=
# Defina como 1 se o site ficar atrás de um proxy (nginx, Render, etc.) para o limite de envios funcionar
TRUST_PROXY=
